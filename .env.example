# ──────────────────────────────────────────────────────────────────────────
# Firebase (required) — the app will not start without these.
#
# Console > Project settings > General > Your apps > SDK setup and config.
# These are public client identifiers, not secrets: they ship in the browser
# bundle by design, and access is controlled by firestore.rules/storage.rules.
# ──────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ──────────────────────────────────────────────────────────────────────────
# Push notifications (optional) — without it the site works, but no device
# notifications are delivered.
#
# Console > Project settings > Cloud Messaging > Web Push certificates.
# ──────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_VAPID_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Server-side only (Vercel environment variables, NOT prefixed with VITE_ and
# never exposed to the browser). Used by /api/push and /api/prerender.
#
# A service account JSON key, on a single line:
#   Console > Project settings > Service accounts > Generate new private key
# THIS IS A REAL SECRET — never commit it.
# ──────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ──────────────────────────────────────────────────────────────────────────
# Seed script only (scripts/add-content.mjs). Writing content requires the
# admin account, because firestore.rules restricts these collections.
# ──────────────────────────────────────────────────────────────────────────
SANAD_ADMIN_EMAIL=admin@sanadz.media
SANAD_ADMIN_PASSWORD=
