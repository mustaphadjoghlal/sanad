rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@sanadz.media';
    }

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Public content (read-only for visitors, write for admin) ─────────
    match /courses/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /jobs/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /competitions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /voice/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /channels/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /theses/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}     { allow read: if true; allow write: if isAdmin(); }

    // ── Users: approved profiles are public; pending/rejected visible only
    //    to their owner and the admin. Owner may delete own account. ──────
    match /users/{userId} {
      allow read: if resource.data.status == 'approved' || isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Equipment: public read; users submit pending items, admin manages ─
    match /equipment/{id} {
      allow read: if true;
      allow create: if isAdmin()
                    || (isAuth()
                        && request.resource.data.submittedBy == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // ── Products: public read, store owner manages their own ─────────────
    match /products/{id} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.storeId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.storeId == request.auth.uid;
    }

    // ── Orders: guest checkout (order form requires no account),
    //    store owner and admin manage ────────────────────────────────────
    match /orders/{id} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update: if isAuth() && resource.data.storeId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Trainer courses: public read, trainer manages own ────────────────
    match /trainerCourses/{id} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.trainerId == request.auth.uid || isAdmin();
    }

    // ── Course registrations: anyone can create, trainer reads own ───────
    match /courseRegistrations/{id} {
      allow create: if true;
      allow read: if isAuth() && resource.data.trainerId == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Notifications: user actions create them (registration, equipment
    //    submissions, guest course sign-ups), so create is open but shape-
    //    checked; non-admins may only mark-as-read ─────────────────────────
    match /notifications/{id} {
      allow read: if isAuth();
      allow create: if request.resource.data.keys().hasOnly(['title', 'body', 'link', 'createdAt', 'readBy'])
                    && request.resource.data.title is string
                    && request.resource.data.createdAt is number
                    && request.resource.data.readBy is list
                    && request.resource.data.readBy.size() == 0;
      allow update: if isAdmin()
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isAdmin();
    }

    // ── Config (admin FCM token): /api/push reads it server-side without
    //    auth (token is unusable without the FCM server key); admin writes ─
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
